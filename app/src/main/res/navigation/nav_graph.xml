<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- DASHBOARD: the first screen shown (startDestination above) -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagementsystemgroupa.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <!-- Arrow: Dashboard -> Add Tenant -->
        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />

        <!-- Arrow: Dashboard -> View Tenants -->
        <action
            android:id="@+id/action_dashboardFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment" />
    </fragment>

    <!-- ADD TENANT -->
    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagementsystemgroupa.AddTenantFragment"
        android:label="Add Tenant"
        tools:layout="@layout/fragment_add_tenant">

        <!-- Arrow: Add Tenant -> View Tenants -->
        <action
            android:id="@+id/action_addTenantFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment" />
    </fragment>

    <!-- VIEW TENANTS -->
    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagementsystemgroupa.ViewTenantsFragment"
        android:label="View Tenants"
        tools:layout="@layout/fragment_view_tenants">

        <!-- Data this screen can receive. Optional: Dashboard sends nothing,
             Add Tenant sends the tenant that was just saved. -->
        <argument
            android:name="newTenant"
            app:argType="com.example.tenantmanagementsystemgroupa.Tenant"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>